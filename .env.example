# Segredo do Auth.js (JWT e cookies de acesso às cartas). Gere com: openssl rand -hex 32
AUTH_SECRET=
# Alias legado; se preencher, use o MESMO valor de AUTH_SECRET
NEXTAUTH_SECRET=
# URL pública da aplicação
NEXTAUTH_URL=http://localhost:3000
# Necessário atrás de proxy/Docker para o Auth.js confiar no host da requisição
AUTH_TRUST_HOST=true

# PostgreSQL (ex.: Neon). Inclua ?sslmode=require quando o provedor exigir
DATABASE_URL=

# Quantos proxies confiaveis ficam na frente da app (Vercel, nginx...). Usado para ler o IP
# real no limite de tentativas. Padrao 1. Use 0 se a app recebe conexoes direto da internet.
TRUSTED_PROXY_HOPS=1
